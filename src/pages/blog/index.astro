---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import { getPublishedPosts, formatDate } from "../../utils/blog";

const posts = await getPublishedPosts();
---

<Layout
    title="Blog — Joni Harju"
    description="Notes, deep dives, and lessons from building for the web."
>
    <Navbar />
    <main
        class="mx-auto w-full max-w-[820px] px-[var(--gutter)] pt-20 pb-[var(--section-y)]"
    >
        <header class="text-center">
            <div class="flex items-center justify-center gap-3">
                <span class="diamond" aria-hidden="true"></span>
                <p class="label-caps m-0 text-accent">Dev Blog</p>
                <span class="diamond" aria-hidden="true"></span>
            </div>
            <h1 class="display-caps mt-7 mb-0 text-3xl sm:text-4xl">Writing</h1>
            <p class="mt-6 mb-0 text-lg text-muted">
                My thoughts, experiences and discoveries
            </p>
            <div class="rule-diamond mt-12" aria-hidden="true">
                <span></span>
            </div>
        </header>

        <div class="mt-4">
            {
                posts.map((post) => (
                    <article class="group border-b border-line">
                        <a
                            href={`/blog/${post.id}/`}
                            class="block py-10 no-underline transition-colors duration-150"
                        >
                            <div class="flex items-center gap-3">
                                <time
                                    datetime={post.data.pubDate.toISOString()}
                                    class="font-ui text-xs font-medium tracking-wider text-muted uppercase"
                                >
                                    {formatDate(post.data.pubDate)}
                                </time>
                                {post.data.draft && (
                                    <span class="rounded-xs border border-accent-line bg-wash px-2 py-0.5 font-ui text-[0.65rem] font-semibold tracking-wider text-accent uppercase">
                                        Draft
                                    </span>
                                )}
                            </div>
                            <h2 class="font-serif mt-3 mb-0 text-3xl font-medium text-ink transition-colors duration-150 group-hover:text-accent">
                                {post.data.title}
                            </h2>
                            <p class="mt-3 mb-0 max-w-[62ch] text-base leading-relaxed text-muted">
                                {post.data.description}
                            </p>
                            <span class="label-caps mt-5 inline-block text-accent">
                                Read More →
                            </span>
                        </a>
                    </article>
                ))
            }
            {
                posts.length === 0 && (
                    <p class="py-16 text-center text-lg text-muted">
                        Nothing here yet — the first post is on its way.
                    </p>
                )
            }
        </div>
    </main>
</Layout>
