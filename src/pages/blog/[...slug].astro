---
import { render } from "astro:content";
import { Image, getImage } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import content from "../../../content.json";
import defaultHero from "../../assets/blog/default-hero.svg";
import { getPublishedPosts, formatDate } from "../../utils/blog";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const hero = post.data.heroImage ?? defaultHero;

// Social cards need a raster image; the site default covers SVG heroes.
let ogImage = "/og-default.png";
if (post.data.heroImage && post.data.heroImage.format !== "svg") {
  const processed = await getImage({ src: post.data.heroImage, width: 1200 });
  ogImage = processed.src;
}

const { social } = content.about;

// heroCredit bypasses the markdown pipeline, so external-link attributes
// are added here instead of by rehype-external-links.
const heroCredit = post.data.heroCredit?.replaceAll(
  "<a ",
  '<a target="_blank" rel="noopener noreferrer" '
);
---

<Layout
  title={`${post.data.title} — Joni Harju`}
  description={post.data.description}
  ogImage={ogImage}
  ogType="article"
>
  <Navbar />
  <main
    class="mx-auto w-full max-w-[820px] px-[var(--gutter)] pt-16 pb-[var(--section-y)]"
  >
    <a
      href="/blog"
      class="label-caps text-muted no-underline transition-colors duration-150 hover:text-accent"
    >
      ← Back to Blog
    </a>

    <header class="mt-12 flex flex-col items-center gap-5 text-center">
      <h1
        class="font-serif m-0 text-4xl font-medium tracking-tight text-ink sm:text-5xl"
      >
        {post.data.title}
      </h1>
      <p
        class="m-0 font-ui text-xs font-medium tracking-wider text-muted uppercase"
      >
        By Joni Harju · <time datetime={post.data.pubDate.toISOString()}
          >{formatDate(post.data.pubDate)}</time
        >
      </p>
      <div class="rule-diamond w-full" aria-hidden="true"><span></span></div>
    </header>

    <Image
      src={hero}
      alt={post.data.heroAlt ?? ""}
      widths={[760, 1520]}
      sizes="(min-width: 900px) 760px, 92vw"
      loading="eager"
      fetchpriority="high"
      class="mt-10 block h-56 w-full rounded-xs border border-line object-cover sm:h-80"
    />

    {
      heroCredit && (
        <p
          class="mt-3 text-center font-ui text-xs text-muted [&_a]:text-muted [&_a]:underline [&_a]:transition-colors [&_a]:duration-150 [&_a:hover]:text-accent"
          set:html={heroCredit}
        />
      )
    }

    <div class="prose-editorial prose mx-auto mt-12">
      <Content />
    </div>

    <footer
      class="mt-16 flex flex-col items-center justify-between gap-6 border-t border-line pt-8 sm:flex-row"
    >
      <p class="font-serif m-0 text-lg text-muted italic">
        Thanks for reading.
      </p>
      <div class="flex items-center gap-6">
        <a
          href={social.github}
          target="_blank"
          rel="noopener noreferrer"
          class="label-caps text-muted no-underline transition-colors duration-150 hover:text-accent"
        >
          GitHub
        </a>
        <a
          href={social.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="label-caps text-muted no-underline transition-colors duration-150 hover:text-accent"
        >
          LinkedIn
        </a>
        <a
          href={`mailto:${social.email}`}
          class="label-caps text-muted no-underline transition-colors duration-150 hover:text-accent"
        >
          Email
        </a>
      </div>
    </footer>
  </main>
</Layout>
