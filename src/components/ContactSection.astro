---
import content from "../../content.json";

const { title, description, email, social, footer } = content.contact;

const year = new Date().getFullYear();
---

<section
  id="contact"
  class="mx-auto w-full max-w-[620px] scroll-mt-20 px-[var(--gutter)] py-[var(--section-y)] text-center"
>
  <h2 class="display-caps m-0 text-xl sm:text-2xl">{title}</h2>
  <div class="rule-diamond mx-auto mt-6 max-w-45" aria-hidden="true">
    <span></span>
  </div>

  <p class="mt-10 mb-0 text-lg leading-relaxed text-body">{description}</p>

  <a
    href={`mailto:${email}`}
    class="font-serif mt-8 inline-block text-2xl font-medium text-ink no-underline transition-colors duration-150 hover:text-accent sm:text-3xl"
  >
    {email}
  </a>

  <div class="mt-10 flex items-center justify-center gap-8">
    <a
      href={social.github}
      target="_blank"
      rel="noopener noreferrer"
      class="label-caps text-muted no-underline transition-colors duration-150 hover:text-accent"
    >
      GitHub
    </a>
    <span class="diamond" aria-hidden="true"></span>
    <a
      href={social.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      class="label-caps text-muted no-underline transition-colors duration-150 hover:text-accent"
    >
      LinkedIn
    </a>
  </div>
</section>

<footer class="border-t border-line">
  <div
    class="mx-auto flex w-full max-w-[var(--content-max)] flex-col items-center gap-4 px-[var(--gutter)] py-10 sm:flex-row sm:justify-between"
  >
    <a href="/" class="flex items-center gap-3 no-underline">
      <span
        class="font-display text-xs font-semibold tracking-widest text-ink uppercase"
      >
        Joni Harju
      </span>
      <span class="diamond" aria-hidden="true"></span>
    </a>
    <p class="m-0 font-ui text-xs tracking-wide text-muted">
      © <span id="footer-year">{year}</span> {footer}
    </p>
  </div>
</footer>

<script>
  // Build-time year is the fallback; keep it current for visitors without a redeploy.
  const yearEl = document.getElementById("footer-year");
  if (yearEl) yearEl.textContent = String(new Date().getFullYear());
</script>
