---
import content from "../../content.json";

const { title, description, social, cv } = content.about;
---

<section
    id="about"
    class="mx-auto w-full max-w-[720px] scroll-mt-20 px-[var(--gutter)] pt-[var(--section-y)] text-center"
>
    <h2 class="display-caps m-0 text-xl sm:text-2xl">{title}</h2>
    <div class="rule-diamond mx-auto mt-6 max-w-45" aria-hidden="true">
        <span></span>
    </div>

    <div class="mt-10 flex flex-col gap-6 text-left sm:text-center">
        {
            description.map((paragraph) => (
                <p class="m-0 text-lg leading-relaxed text-body">{paragraph}</p>
            ))
        }
    </div>

    <div
        class="mt-10 flex flex-wrap items-center justify-center gap-x-8 gap-y-3"
    >
        <a
            href={social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="label-caps text-muted no-underline transition-colors duration-150 hover:text-accent"
        >
            GitHub
        </a>
        <a
            href={social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="label-caps text-muted no-underline transition-colors duration-150 hover:text-accent"
        >
            LinkedIn
        </a>
        <a
            href={`mailto:${social.email}`}
            class="label-caps text-muted no-underline transition-colors duration-150 hover:text-accent"
        >
            Email
        </a>
        <a
            href={cv}
            target="_blank"
            rel="noopener noreferrer"
            class="label-caps border border-line-strong px-5 py-2.5 text-ink no-underline transition-colors duration-150 hover:border-accent hover:text-accent"
        >
            Download CV
        </a>
    </div>
</section>
