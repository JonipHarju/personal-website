---
import { Image } from "astro:assets";
import content from "../../content.json";
import { getProjectImage } from "../utils/getProjectImage";

const { title, subtitle, professionalWork, personalProjects } =
  content.projects;

const allProjects = [
  ...professionalWork.list,
  ...personalProjects.list,
];

const projectsWithImages = await Promise.all(
  allProjects.map(async (project) => ({
    ...project,
    resolvedImage: await getProjectImage(project.image),
  }))
);
---

<section
  id="projects"
  class="mx-auto w-full max-w-[var(--content-max)] scroll-mt-20 px-[var(--gutter)] py-[var(--section-y)]"
>
  <div class="text-center">
    <h2 class="display-caps m-0 text-xl sm:text-2xl">{title}</h2>
    <p class="label-caps mt-4 mb-0">{subtitle}</p>
  </div>

  <div class="mt-14 grid grid-cols-1 gap-7 md:grid-cols-2 lg:grid-cols-3">
    {
      projectsWithImages.map((project) => (
        <article class="flex flex-col overflow-hidden rounded-xs border border-line bg-card shadow-xs transition-[border-color] duration-200 ease-[var(--ease-out)] hover:border-accent-line">
          {project.resolvedImage && (
            <div class="overflow-hidden border-b border-line">
              <Image
                src={project.resolvedImage}
                alt={`Screenshot of ${project.title}`}
                width={760}
                height={372}
                fit="cover"
                position="top"
                widths={[400, 640, 760]}
                sizes="(min-width: 1024px) 360px, (min-width: 768px) 45vw, 92vw"
                class="block h-44 w-full object-cover object-top"
              />
            </div>
          )}
          <div class="flex grow flex-col gap-4 p-6">
            <h3 class="font-serif m-0 text-2xl font-medium text-ink">
              {project.title}
            </h3>
            <p class="m-0 grow text-[0.95rem] leading-relaxed text-muted">
              {project.description}
            </p>
            <div class="flex flex-wrap gap-2">
              {project.technologies.map((tech) => (
                <span class="rounded-xs border border-accent-line bg-wash px-2 py-1 font-display text-[0.65rem] font-semibold tracking-wider text-accent uppercase">
                  {tech}
                </span>
              ))}
            </div>
            {(project.links.preview || project.links.github) && (
              <div class="flex gap-6 border-t border-line pt-4">
                {project.links.preview && (
                  <a
                    href={project.links.preview}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="label-caps text-accent no-underline transition-colors duration-150 hover:text-accent-hover"
                  >
                    Visit Site →
                  </a>
                )}
                {project.links.github && (
                  <a
                    href={project.links.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="label-caps text-muted no-underline transition-colors duration-150 hover:text-accent"
                  >
                    GitHub
                  </a>
                )}
              </div>
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>
