---
import content from "../../content.json";

const { title, subtitle, categories } = content.skills;
---

<section
  id="skills"
  class="scroll-mt-20 border-y border-line bg-paper-raised"
>
  <div
    class="mx-auto w-full max-w-[var(--content-max)] px-[var(--gutter)] py-[var(--section-y)]"
  >
    <div class="text-center">
      <h2 class="display-caps m-0 text-xl sm:text-2xl">{title}</h2>
      <p class="label-caps mt-4 mb-0">{subtitle}</p>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-10 md:grid-cols-3">
      {
        categories.map((category) => (
          <div class="flex flex-col gap-5">
            <div class="flex items-center gap-3">
              <span class="diamond" aria-hidden="true" />
              <h3 class="label-caps m-0 text-ink">{category.name}</h3>
            </div>
            <div class="flex flex-wrap gap-2.5">
              {category.skills.map((skill) => (
                <span class="rounded-xs border border-line bg-card px-3 py-1.5 font-ui text-[0.8rem] tracking-wide text-body shadow-xs">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
