---
import content from "../../content.json";

const { title, subtitle, description, cta } = content.heroSection;
---

<section
  class="mx-auto flex w-full max-w-[var(--content-max)] flex-col items-center px-[var(--gutter)] pt-28 pb-24 text-center sm:pt-36 sm:pb-28"
>
  <div class="flex items-center gap-3">
    <span class="diamond" aria-hidden="true"></span>
    <p class="label-caps m-0 text-accent">{subtitle}</p>
    <span class="diamond" aria-hidden="true"></span>
  </div>

  <h1
    class="display-caps mt-8 mb-0 text-4xl [font-size:clamp(2.25rem,7vw,4.5rem)]"
  >
    {title}
  </h1>

  <p
    class="font-serif mt-7 mb-0 max-w-xl text-2xl font-medium text-body italic sm:text-3xl"
  >
    {description}
  </p>

  <div class="mt-12 flex flex-wrap items-center justify-center gap-4">
    <a
      href="/#about"
      class="label-caps border border-line-strong bg-transparent px-6 py-3 text-ink no-underline transition-colors duration-150 hover:border-accent hover:text-accent"
    >
      {cta}
    </a>
    <a
      href="/blog"
      class="label-caps border border-transparent px-6 py-3 text-muted no-underline transition-colors duration-150 hover:text-accent"
    >
      Read the Blog →
    </a>
  </div>
</section>
