---
import ThemeToggle from "./ThemeToggle.astro";

const links = [
    { label: "About", href: "/#about" },
    { label: "Projects", href: "/#projects" },
    { label: "Skills", href: "/#skills" },
    { label: "Contact", href: "/#contact" },
    // Blog hidden for now — /blog still works, just not linked. Re-enable later.
    // { label: "Blog", href: "/blog" },
];

const currentPath = Astro.url.pathname;
const isBlog = currentPath.startsWith("/blog");
---

<header
    class="sticky top-0 z-50 border-b border-line bg-overlay backdrop-blur-md"
>
    <div
        class="mx-auto flex h-16 w-full max-w-[var(--content-max)] items-center justify-between px-[var(--gutter)]"
    >
        <a
            href="/"
            class="flex items-center gap-3 no-underline"
            aria-label="Joni Harju — home"
        >
            <span
                class="font-display text-sm font-semibold tracking-widest text-ink uppercase"
            >
                Joni Harju
            </span>
            <span class="diamond" aria-hidden="true"></span>
        </a>

        <nav class="hidden items-center gap-7 sm:flex" aria-label="Main">
            {
                links.map((link) => (
                    <a
                        href={link.href}
                        class:list={[
                            "label-caps no-underline transition-colors duration-150 hover:text-accent",
                            link.label === "Blog" && isBlog
                                ? "text-accent"
                                : "text-muted",
                        ]}
                    >
                        {link.label}
                    </a>
                ))
            }
            <ThemeToggle />
        </nav>

        <button
            id="menu-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="mobile-menu"
            aria-label="Toggle menu"
            class="inline-flex h-9 w-9 cursor-pointer items-center justify-center rounded-full border border-line bg-transparent text-muted transition-colors duration-150 hover:border-accent-line hover:text-accent sm:hidden"
        >
            <svg
                class="menu-icon-open h-4 w-4"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <path d="M4 7h16M4 12h16M4 17h16"></path>
            </svg>
            <svg
                class="menu-icon-close hidden h-4 w-4"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <path d="M6 6l12 12M18 6L6 18"></path>
            </svg>
        </button>
    </div>

    <div id="mobile-menu" class="hidden border-t border-line sm:hidden">
        <nav
            class="flex flex-col gap-1 px-[var(--gutter)] py-4"
            aria-label="Mobile"
        >
            {
                links.map((link) => (
                    <a
                        href={link.href}
                        class:list={[
                            "label-caps rounded px-1 py-2.5 no-underline transition-colors duration-150 hover:text-accent",
                            link.label === "Blog" && isBlog
                                ? "text-accent"
                                : "text-muted",
                        ]}
                    >
                        {link.label}
                    </a>
                ))
            }
            <div class="mt-2 flex items-center gap-3 px-1">
                <ThemeToggle />
            </div>
        </nav>
    </div>
</header>

<script>
    const menuToggle = document.getElementById("menu-toggle");
    const mobileMenu = document.getElementById("mobile-menu");
    const iconOpen = menuToggle?.querySelector(".menu-icon-open");
    const iconClose = menuToggle?.querySelector(".menu-icon-close");

    const setMenu = (open: boolean) => {
        menuToggle?.setAttribute("aria-expanded", String(open));
        mobileMenu?.classList.toggle("hidden", !open);
        iconOpen?.classList.toggle("hidden", open);
        iconClose?.classList.toggle("hidden", !open);
    };

    menuToggle?.addEventListener("click", () => {
        setMenu(menuToggle.getAttribute("aria-expanded") !== "true");
    });

    mobileMenu?.querySelectorAll("a, .theme-toggle").forEach((el) => {
        el.addEventListener("click", () => setMenu(false));
    });

    document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") setMenu(false);
    });
</script>
